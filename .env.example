# Copy this file to .env.local and fill in the values. Never commit real keys.

# --- Supabase (required: database + sign-in) ---
# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key. Server only. Never put this in the browser or in git.
SUPABASE_SERVICE_ROLE_KEY=

# --- Public address of the site (used in emails and link previews) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (optional: card deposits) ---
# Without this, venues can still accept bookings with a $0 deposit.
STRIPE_SECRET_KEY=

# --- Resend (optional: email notifications) ---
# Without this, everything works but nobody gets emails.
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend, e.g. "Stagecraft <hello@yourdomain.com>"
STAGECRAFT_FROM_EMAIL=
STAGECRAFT_REPLY_TO=
